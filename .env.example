# Frontend Chat API endpoint (points to /api/chat serverless proxy)
# Leave empty to run 100% locally with the 0-token Intent Router
VITE_CHAT_API_URL=/api/chat

# Server-side only (never prefix with VITE_)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Webhook URL for Lead Capture
VITE_WEBHOOK_URL=
